# Secrets are deliberately blank. Supply through the existing secret-management route.
FIREWORKS_API_KEY=
# Existing working model. Candidate: accounts/abloomster/models/dynamite-sales-qwen27b-v3c.
# v3c is trained but not served at Oct 22 readback; set its verified inference ID after acceptance.
# An explicit selection is never silently replaced by a base-model fallback.
FIREWORKS_SALES_MODEL=accounts/fireworks/models/qwen3p8-2p4t-a95b

# Required bearer token for authenticated Mastra API routes; unset rejects access.
MASTRA_API_TOKEN=
# Postgres connection used by BOTH Mastra memory and application/work records.
# Neon target project: twilight-glade-11976094. No migration/cutover is implied here.
# Supply the chosen pooled connection URL privately; do not copy production into examples.
DATABASE_URL=

# Public GHL webhook requires x-webhook-secret. Normal processing prepares drafts.
GHL_WEBHOOK_SECRET=
GHL_API_KEY=
GHL_LOCATION_ID=
JOBBER_ACCESS_TOKEN=

# Customer sends and external quote-handoff effects remain off pending exact approval.
GHL_SEND_ENABLED=false
GHL_TEST_SEND_ENABLED=false
BOT_TEST_PHONES=
FLOW_TAG=false
FLOW_JOBBER_QUOTE=false
FLOW_MARVIN_TASK=false

# Optional hosted photo base URL. Unset uses per-photo URLs, otherwise no attachment.
PHOTO_BASE_URL=

# Company context is prepared, inactive. Enabling it makes metered recall/retain calls.
# This company/bank pair is fixed; there is no alex-agents fallback.
HINDSIGHT_ENABLED=false
PAPERCLIP_COMPANY_ID=f63a396b-956e-42ca-9916-88d98f4a54fe
HINDSIGHT_BANK_ID=paperclip::f63a396b-956e-42ca-9916-88d98f4a54fe
# Bank-scoped key must list exactly the bank above. Runtime key not provisioned/proved.
HINDSIGHT_API_KEY=
# Comma-separated existing knowledge-page IDs, at most three. None provisioned/proved.
HINDSIGHT_PAGE_IDS=

# Private dashboard chat uses existing Fireworks credits; enable after spend approval.
MANNY_CHAT_ENABLED=false
